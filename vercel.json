{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/index.html"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(og-image\\.png|apple-touch-icon\\.png|favicon\\.svg|manifest\\.webmanifest)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/index?__route=/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/index?__route=/sitemap.xml" },
    { "source": "/api/((?!index).*)", "destination": "/api/index?__route=/api/$1" },
    { "source": "/work/:slug", "destination": "/api/index?__route=/work/:slug" },
    { "source": "/blog/:slug", "destination": "/api/index?__route=/blog/:slug" },
    { "source": "/(.*)", "destination": "/api/index?__route=/404" }
  ]
}
